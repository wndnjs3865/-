# QuantPulse v3 Environment Configuration
# Copy to .env and fill in your values

# Trading
TRADE_MODE=PAPER
MAX_RISK_PER_TRADE=0.01
MAX_DAILY_LOSS=0.03
MAX_OPEN_POSITIONS=5
MAX_LEVERAGE=10.0
DEFAULT_LEVERAGE=3.0
MIN_QUANT_SCORE=60.0
MIN_RISK_REWARD=2.0
CIRCUIT_BREAKER_LOSS=0.05
CIRCUIT_BREAKER_COOLDOWN=3600

# Exchange APIs
BINANCE_API_KEY=
BINANCE_API_SECRET=
BYBIT_API_KEY=
BYBIT_API_SECRET=
ALPACA_API_KEY=
ALPACA_API_SECRET=

# Notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ENABLE_TELEGRAM=false

# System
LOG_LEVEL=INFO
AUDIT_DB_PATH=data/audit.db
API_HOST=0.0.0.0
API_PORT=8000
