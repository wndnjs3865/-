# ═══════════════════════════════════════════
# QuantPulse v3 — Environment Configuration
# Copy to .env and fill in your values
# ═══════════════════════════════════════════

# ── Trading ──────────────────────────────
TRADE_MODE=PAPER                   # PAPER or LIVE
MAX_RISK_PER_TRADE=0.01            # 1% per trade
MAX_DAILY_LOSS=0.03                # 3% daily loss limit
MAX_OPEN_POSITIONS=5
MAX_LEVERAGE=10.0
DEFAULT_LEVERAGE=3.0
MIN_QUANT_SCORE=60.0               # Minimum QR score to trade
MIN_RISK_REWARD=2.0
CIRCUIT_BREAKER_LOSS=0.05          # 5% triggers circuit breaker
CIRCUIT_BREAKER_COOLDOWN=3600      # 1 hour cooldown (seconds)
INITIAL_CAPITAL=10000.0            # Starting capital (USD)

# ── Execution ────────────────────────────
SLIPPAGE_BPS=2.0                   # Paper mode slippage (basis points)
COMMISSION_RATE=0.0004             # 0.04% taker fee
TRAILING_STOP_PCT=0.005            # 0.5% trailing distance
TP1_CLOSE_PCT=0.5                  # Close 50% at TP1
TP2_CLOSE_PCT=0.3                  # Close 30% at TP2
TP3_CLOSE_PCT=0.2                  # Close 20% at TP3

# ── Exchange APIs ────────────────────────
EXCHANGE_TESTNET=false             # true = use testnet/sandbox

# Binance Futures (testnet: https://testnet.binancefuture.com)
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Bybit
BYBIT_API_KEY=
BYBIT_API_SECRET=

# Alpaca (US Stocks / Nasdaq)
ALPACA_API_KEY=
ALPACA_API_SECRET=

# ── Notifications ────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ENABLE_TELEGRAM=false

# ── System ───────────────────────────────
LOG_LEVEL=INFO
AUDIT_DB_PATH=data/audit.db
API_HOST=0.0.0.0
API_PORT=8000
PRICE_FEED_INTERVAL=5.0
ANALYSIS_INTERVAL=60.0
