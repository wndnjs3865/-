# ============================================
# Quant Trading Bot Configuration
# ============================================

# === 한국투자증권 API ===
KIS_APP_KEY=your_app_key_here
KIS_APP_SECRET=your_app_secret_here
KIS_ACCOUNT_NO=00000000-00
# REAL or VIRTUAL (모의투자)
KIS_ENV=VIRTUAL

# === AI API Keys ===
OPENAI_API_KEY=your_openai_key_here
ANTHROPIC_API_KEY=your_anthropic_key_here
XAI_API_KEY=your_xai_grok_key_here

# === Telegram ===
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_chat_id

# === Database ===
DATABASE_URL=sqlite+aiosqlite:///./quant_bot.db
REDIS_URL=redis://localhost:6379/0

# === Risk Parameters ===
MAX_PORTFOLIO_RISK=0.02
MAX_SINGLE_POSITION_PCT=0.10
MAX_DAILY_LOSS_PCT=0.03
MAX_DRAWDOWN_PCT=0.15
VAR_CONFIDENCE=0.99

# === Trading Parameters ===
TRADING_UNIVERSE=US
DEFAULT_STRATEGY=multi_factor
REBALANCE_FREQUENCY=daily
MARKET_OPEN_HOUR=9
MARKET_CLOSE_HOUR=16

# === Logging ===
LOG_LEVEL=INFO
LOG_FILE=logs/quant_bot.log
